# Copy to .env and fill in. `docker compose` reads .env automatically.

# --- required ---
# Provider credential for the node (Pi reads it at runtime; never stored).
# Not needed when the OpenAI-compatible block below carries the credential.
DEEPSEEK_API_KEY=
# Northbound API key(s), comma-separated. The entrypoint refuses to boot empty.
# Generate: openssl rand -hex 16
PI_FACADE_API_KEYS=

# --- optional: OpenAI-compatible endpoint ---
# Any endpoint speaking the OpenAI chat-completions API (OpenAI itself,
# OneAPI/new-api proxies, vLLM, SGLang, Ollama, ...). Setting PI_OPENAI_BASE_URL
# makes the facade synthesize a models.json provider entry at boot; the key is
# referenced by env interpolation and never lands on disk. Then select it with
# PI_FACADE_MODEL=<provider>/<model-id>.
#
# SHARED VOCABULARY: every variable below also accepts the neutral name used by
# the sibling dsh-api-gateway standalone stack — OPENAI_BASE_URL / OPENAI_API_KEY
# / OPENAI_PROVIDER / OPENAI_MODELS (+ OPENAI_MODEL single shorthand) and
# FACADE_MODEL — so one .env dictionary can drive a Pi node and a DSH node alike.
# On conflict the PI_* name wins.
#PI_OPENAI_BASE_URL=https://api.openai.com/v1
#PI_OPENAI_API_KEY=sk-...            # omit for key-less endpoints (Ollama);
                                     # OPENAI_API_KEY also works for provider "openai"
#PI_OPENAI_PROVIDER=openai           # "openai" keeps the built-in catalog model ids;
                                     # a custom id requires PI_OPENAI_MODELS
#PI_OPENAI_MODELS=                   # comma-separated ids the catalog lacks (vLLM aliases etc.)
#PI_FACADE_MODEL=openai/gpt-4o-mini  # example selection for the synthesized provider

# --- optional ---
# Default model for new sessions (Pi catalog ids).
PI_FACADE_MODEL=deepseek/deepseek-flash
# External HTTP port of the nginx front door. 8090 avoids the DAC production
# surface (8080 manager, 3081-3091 nodes).
HTTP_PORT=8090
# Facade image tag (informational; the build produces it).
FACADE_VERSION=0.1.0
# Unlock the danger-full-access sandbox tier on this node (ops nodes only).
#PI_FACADE_ALLOW_FULL_ACCESS=false
# Bind-mount uid/gid (Linux hosts; ignored by Docker Desktop). MUST match the
# user that owns ./workspaces — containers run as this uid, and a mismatch
# means EACCES the moment anything writes to a workspace (demo BFF seeding,
# agent tool writes, the git audit hook). Set with: HOST_UID=$(id -u)
#HOST_UID=1000
#HOST_GID=1000
# China mirrors when Docker Hub / npmjs are unreachable:
#NODE_IMAGE=docker.m.daocloud.io/library/node:24-bookworm-slim
#NPM_REGISTRY=https://registry.npmmirror.com
#NGINX_IMAGE=docker.m.daocloud.io/library/nginx:alpine
